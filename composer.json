{
  "name": "skitlabs/ip-restriction-for-laravel",
  "description": "Configurable IP allow/blocklist middleware for Laravel.",
  "keywords": [
    "IP",
    "CIDR",
    "allowlist",
    "blocklist",
    "whitelist",
    "blacklist",
    "middleware"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Jurre Vriezinga",
      "email": "j.vriezinga@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "illuminate/routing": "^12.0|^13.0",
    "symfony/http-foundation": "^7.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0",
    "laravel/pint": "^1.30"
  },
  "autoload": {
    "psr-4": {
      "Skitlabs\\IpRestriction\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Skitlabs\\IpRestriction\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Skitlabs\\IpRestriction\\IpRestrictionServiceProvider"
      ],
      "aliases": {}
    }
  },
  "minimum-stability": "stable",
  "scripts": {
    "test": "./vendor/bin/phpunit"
  }
}
